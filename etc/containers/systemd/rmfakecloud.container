[Unit]
Description=rmfakecloud
PartOf=rmfakecloud.target

[Container]
ContainerName=rmfakecloud
Image=docker.io/ddvk/rmfakecloud:latest
AutoUpdate=registry

PublishPort=3000:3000/tcp
Network=rmfakecloud.network

Volume=/srv/rmfakecloud/rmfakecloud:/data:Z
ReadOnly=true

EnvironmentFile=/srv/rmfakecloud/rmfakecloud.env

NoNewPrivileges=true
DropCapability=ALL

[Service]
LockPersonality=true
ProtectClock=true
RestrictRealtime=true
RuntimeDirectoryMode=700
SystemCallArchitectures=native
SystemCallFilter=~@obsolete

Restart=always

[Install]
WantedBy=rmfakecloud.target